{
  "name": "workspace-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "start:full": "concurrently \"npm run start\" \"npm run server\"",
    "db:push:workflow": "prisma db push --schema=automation-workflow/prisma/schema.prisma",
    "dev:all": "npm run db:push:workflow && concurrently \"npm run dev\" \"npm run server\" \"npm run dev --prefix automation-workflow/backend\" \"npm run dev --prefix automation-workflow/frontend\"",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prisma": "^5.22.0"
  }
}
