# ==============================================================================
# UNIFIED PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env and replace placeholder values for production deployment
# ==============================================================================

# Database Configuration (Prisma / PostgreSQL / SQLite)
DATABASE_URL="postgres://user:password@localhost:5432/neuron_flow?sslmode=require"
WORKFLOW_DATABASE_URL="file:./dev.db"

# Server Ports & Host URLs
PORT=4000
EXPRESS_PORT=4001
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3001"

# --- REAL EMAIL SMTP CONFIGURATION ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_SECURE=false
EMAIL_FROM="NEURON_FLOW Automation <noreply@yourdomain.com>"

# --- RABBITMQ BROKER CONFIGURATION ---
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_QUEUE_NAME="neuron_flow_queue"

# --- AI & INTEGRATION KEYS ---
OPENAI_API_KEY="sk-proj-your-openai-key"
BETTER_AUTH_SECRET="your-production-secret-key-32-chars-minimum"
GOOGLE_CLIENT_EMAIL="your-service-account@developer.gserviceaccount.com"

# --- SECURITY & ENCRYPTION ---
ENCRYPTION_KEY="your-32-character-secret-encryption-key"

# --- CLERK AUTHENTICATION CONFIGURATION ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_live_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- AWS S3 FILE STORAGE CONFIGURATION ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAYOURAWSKEYID"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="neuron-vault-shares"
STORAGE_PROVIDER="s3"
